{
  "name": "kostberakning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "rm -rf dist && tsc -b && vite build --outDir dist/app && cp site/index.html public/CNAME dist/",
    "build:single": "tsc -b && vite build --mode single",
    "test": "vitest run",
    "update-data": "node scripts/update-livsmedel.mjs",
    "convert-usda": "node scripts/convert-usda.mjs",
    "convert-fineli": "node scripts/convert-fineli.mjs",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
